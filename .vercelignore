# Files/folders excluded from Vercel builds.
#
# NOTE: The `api/` folder is NOT ignored — it contains the Python
# Serverless Function that Vercel auto-detects and deploys.

# Original backend (kept in repo for local dev, but NOT deployed on Vercel).
# The Vercel API lives in /api/index.py which is self-contained.
backend/

# Dev-only
tests/
test_reports/
memory/
test_result.md

# Local env files (Vercel uses its own env-var UI)
**/.env
**/.env.local
**/.env.*

# Node & build artefacts
node_modules/
**/node_modules/
frontend/build/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Emergent-only
.emergent/
plugins/health-check/
