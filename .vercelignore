# Files/folders excluded from Vercel uploads.
#
# NOTE: `backend/` and `frontend/` are BOTH deployed (see vercel.json services).
# Do NOT ignore them here.

# Dev-only
tests/
test_reports/
memory/
test_result.md

# Local env files (Vercel uses its own env-var UI)
**/.env
**/.env.local
**/.env.*

# Node & build artefacts
node_modules/
**/node_modules/
frontend/build/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Emergent-only (safe to strip on Vercel)
.emergent/
plugins/health-check/

# Python
__pycache__/
*.pyc
.venv/
venv/
