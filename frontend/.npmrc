# Required for Vercel / npm installs.
# The project is developed with yarn (uses "resolutions" in package.json).
# npm doesn't understand yarn's "resolutions" and enforces strict peer-dep
# checks by default, which fails for react-day-picker@8 + date-fns@4.
# `legacy-peer-deps` reverts to the pre-npm-v7 behaviour (warn instead of error).
legacy-peer-deps=true

# Make installs a bit faster on CI (Vercel)
audit=false
fund=false
